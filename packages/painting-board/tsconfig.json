{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "types": ["react", "react-native", "jest"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
