{
  "name": "@hamster-note/painting-board",
  "version": "0.6.1-dev.ham66.20261025.0",
  "private": false,
  "description": "Full-bleed PaintingBoard component built on @hamster-note/painting with virtual-paper pan/zoom enabled by default",
  "repository": {
    "type": "git",
    "url": "https://github.com/HamsterNote/painting.git",
    "directory": "packages/painting-board"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "exports": {
    ".": {
      "react-native": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "bob build",
    "test": "pnpm --dir ../.. test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "dependencies": {
    "@hamster-note/painting": "0.6.1-dev.ham66.20261025.0"
  }
}
