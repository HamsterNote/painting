{
  "name": "@hamster-note/painting",
  "version": "0.6.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/HamsterNote/painting.git",
    "directory": "packages/painting"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./core": {
      "react-native": {
        "types": "./lib/typescript/module/core/index.d.ts",
        "default": "./src/core/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/core/index.d.ts",
        "default": "./lib/module/core/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/core/index.d.ts",
        "default": "./lib/commonjs/core/index.js"
      }
    },
    "./skia": {
      "react-native": {
        "types": "./lib/typescript/module/skia/index.d.ts",
        "default": "./src/skia/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/skia/index.d.ts",
        "default": "./lib/module/skia/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/skia/index.d.ts",
        "default": "./lib/commonjs/skia/index.js"
      }
    },
    "./input/web": {
      "react-native": {
        "types": "./lib/typescript/module/input/web/index.d.ts",
        "default": "./src/input/web/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/input/web/index.d.ts",
        "default": "./lib/module/input/web/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/input/web/index.d.ts",
        "default": "./lib/commonjs/input/web/index.js"
      }
    },
    "./ruler": {
      "react-native": {
        "types": "./lib/typescript/module/ruler/index.d.ts",
        "default": "./src/ruler/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/ruler/index.d.ts",
        "default": "./lib/module/ruler/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/ruler/index.d.ts",
        "default": "./lib/commonjs/ruler/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "bob build",
    "test": "pnpm --dir ../.. test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "^2.6.2",
    "react": "^19.0.0",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.8.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "dependencies": {
    "@hamster-note/components": "0.3.0",
    "perfect-freehand": "1.2.3",
    "polyclip-ts": "0.16.8",
    "robust-predicates": "2.0.4",
    "use-undo": "1.2.0"
  }
}
