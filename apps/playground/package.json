{
  "name": "@hamster-note/painting-playground",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "node scripts/start-web.mjs",
    "dev:native": "expo start --dev-client --lan --port 5266",
    "dev:android": "pnpm run dev:native --android",
    "dev:ios": "pnpm run dev:native --ios",
    "prebuild": "expo prebuild",
    "native:android": "expo run:android --port 5266",
    "native:ios": "expo run:ios --port 5266",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@hamster-note/components": "0.3.0",
    "@hamster-note/painting": "*",
    "@hamster-note/painting-board": "*",
    "@hamster-note/painting-android-ink": "workspace:*",
    "@hamster-note/painting-pencilkit": "*",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~57.0.12",
    "typescript": "~6.0.3"
  }
}
