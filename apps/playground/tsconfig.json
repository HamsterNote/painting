{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@hamster-note/painting": [
        "../../packages/painting/src/index.ts"
      ],
      "@hamster-note/painting-board": [
        "../../packages/painting-board/src/index.tsx"
      ]
    }
  },
  "include": [
