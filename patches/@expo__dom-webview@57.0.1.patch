+  func requestFocus() {
+    guard let webView, webView.window != nil else { return }
+    // The DOM action crosses an async bridge. Recheck the live active element
+    // here so a delayed menu request cannot interrupt typing or an IME session.
+    let isNonEditingScript = """
+    (() => {
+      const active = document.activeElement;
+      if (!active) return true;
+      if (active.isContentEditable || active.matches('textarea,select')) return false;
+      return active.tagName !== 'INPUT' ||
+        ['button', 'submit', 'reset', 'checkbox', 'radio', 'range'].includes(active.type);
+    })()
+    """
+    webView.evaluateJavaScript(isNonEditingScript) { [weak webView] result, error in
+      guard error == nil, let mayFocus = result as? Bool, mayFocus,
+        let webView, webView.window != nil else { return }
+      // WKWebView forwards this public API to its content responder. Do not
+      // dispatch synthetic key events or interfere with WebKit's text input.
+      webView.becomeFirstResponder()
+    }
+  }
+
   func injectJavaScript(_ script: String) {
     DispatchQueue.main.async { [weak self] in
       self?.webView?.evaluateJavaScript(script)
