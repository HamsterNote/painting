--- a/ios/DomWebView.swift
+++ b/ios/DomWebView.swift
@@ -9,6 +9,55 @@ import WebKit
 final class DomWKWebView: WKWebView {
   var hidesInputAccessoryView = false
 
+  // Opt-in only while the DOM toolbar owns non-editing focus. Public UIKit
+  // commands consume the shortcut once; do not also forward raw presses.
+  var toolbarKeyboardScope = ""
+  private var toolbarKeySequence = 0
+
+  override var keyCommands: [UIKeyCommand]? {
+    guard !toolbarKeyboardScope.isEmpty else { return super.keyCommands }
+    let commands = [
+      UIKeyCommand(input: UIKeyCommand.inputEscape, modifierFlags: [], action: #selector(toolbarKey(_:))),
+      UIKeyCommand(input: "\t", modifierFlags: [], action: #selector(toolbarKey(_:))),
+      UIKeyCommand(input: "\t", modifierFlags: .shift, action: #selector(toolbarKey(_:)))
+    ]
+    for command in commands {
+      command.wantsPriorityOverSystemBehavior = true
+    }
+    return commands + (super.keyCommands ?? [])
+  }
+
+  override func canPerformAction(_ action: Selector, withSender sender: Any?) -> Bool {
+    if action == #selector(toolbarKey(_:)) {
+      return !toolbarKeyboardScope.isEmpty && window?.isKeyWindow == true
+    }
+    return super.canPerformAction(action, withSender: sender)
+  }
+
+  @objc private func toolbarKey(_ command: UIKeyCommand) {
+    guard !toolbarKeyboardScope.isEmpty, window?.isKeyWindow == true,
+      window?.windowScene?.activationState == .foregroundActive,
+      let input = command.input,
+      input == "\t" || input == UIKeyCommand.inputEscape else { return }
+    toolbarKeySequence += 1
+    let payload: [String: Any] = [
+      "scope": toolbarKeyboardScope, "sequence": toolbarKeySequence,
+      "key": input == "\t" ? "Tab" : "Escape",
+      "shiftKey": command.modifierFlags.contains(.shift), "source": "ios-key-command"
+    ]
+    guard let data = try? JSONSerialization.data(withJSONObject: payload),
+      let json = String(data: data, encoding: .utf8) else { return }
+    // No isTrusted override: this fallback deliberately produces an untrusted
+    // DOM event. The command must originate in UIKit's real keyboard path.
+    let script = "window.__paintingToolbarKeyboard?.receive(\(json)) ?? false"
+    evaluateJavaScript(script) { result, error in
+      #if DEBUG
+      NSLog("[HAM175 keyboard] payload=%@ accepted=%@ error=%@", json,
+        String(describing: result), String(describing: error))
+      #endif
+    }
+  }
+
   override var inputAccessoryView: UIView? {
     hidesInputAccessoryView ? nil : super.inputAccessoryView
   }
